# Environment
.env

# User settings (API keys — never commit)
data/settings.json

# Personal access tokens. Hashes, not plaintext — but it is still the list of who
# holds a live credential on this deployment, and it is per-machine state, not source.
data/access-tokens.json

# Data-backed allowlist / admins / quotas (multi-user Phase 4). Per-deployment
# state edited from Settings → Administration, not source.
data/access-control.json

# Local backups pulled from the deployment (`npm run backup:prod`). Other people's
# scripts live in here on a multi-tester deployment — never commit.
backups/

# Project data
data/projects/
data/source-files/
data/projects-manifest.json

# Node
node_modules/

# Editor / OS cruft — these were tracked by accident and showed as deleted for weeks
# after an iCloud sync moved them, which is noise on every `git status`.
.DS_Store
.vscode/
